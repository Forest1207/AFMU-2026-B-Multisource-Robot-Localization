  <diagram id="q4-optimization-framework" name="问题四优化框架">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="问题四固定轨迹任务调度的求解与优化框架" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="g1" value="输入与状态" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#315B73;" vertex="1" parent="1"><mxGeometry x="55" y="85" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="g2" value="候选构造" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2D6A4F;" vertex="1" parent="1"><mxGeometry x="335" y="85" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="g3" value="基线与精确优化" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#6A4C78;" vertex="1" parent="1"><mxGeometry x="710" y="85" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="g4" value="输出与复核" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#8A4F45;" vertex="1" parent="1"><mxGeometry x="1160" y="85" width="180" height="30" as="geometry" /></mxCell>

        <mxCell id="input_state" value="轨迹状态" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#D9EAF7;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="input_state_text" value="&lt;i&gt;s&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;) = (&lt;b&gt;p&lt;/b&gt;, &lt;i&gt;v&lt;/i&gt;, &lt;i&gt;a&lt;/i&gt;)&lt;br&gt;问题三输出的 10 Hz 状态" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="input_state"><mxGeometry y="30" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="input_target" value="任务对象" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#D9EAF7;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="input_target_text" value="目标坐标 &lt;b&gt;g&lt;/b&gt;&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;射击与拍照任务类型" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="input_target"><mxGeometry y="30" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="input_rule" value="规则参数" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#D9EAF7;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="input_rule_text" value="&lt;i&gt;L&lt;/i&gt;&lt;sub&gt;s&lt;/sub&gt;, &lt;i&gt;L&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt;, ε&lt;br&gt;距离、速度、加速度、角差" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="input_rule"><mxGeometry y="30" width="220" height="90" as="geometry" /></mxCell>

        <mxCell id="window" value="完整准备窗筛选" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#DDF1E4;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="window_text" value="&lt;i&gt;I&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt; = [&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt; − &lt;i&gt;L&lt;/i&gt;&lt;sub&gt;k&lt;/sub&gt;, &lt;i&gt;t&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;]&lt;br&gt;窗口内各时刻均满足物理约束" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="window"><mxGeometry y="30" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="compress" value="候选压缩" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#DDF1E4;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="310" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="compress_text" value="时间步长 &lt;i&gt;h&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;方向角分箱 Δθ&lt;br&gt;保留高裕度代表点" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="compress"><mxGeometry y="30" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="verify" value="细网格复核" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#DDF1E4;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="verify_text" value="复核步长 &lt;i&gt;h&lt;/i&gt;&lt;sub&gt;f&lt;/sub&gt;&lt;br&gt;计算 &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;，形成候选集 𝒞" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="verify"><mxGeometry y="30" width="230" height="90" as="geometry" /></mxCell>

        <mxCell id="greedy" value="贪心基线" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#F8E9C7;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="greedy_text" value="按执行时刻扫描&lt;br&gt;得到下界 &lt;i&gt;N&lt;/i&gt;&lt;sub&gt;G&lt;/sub&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="greedy"><mxGeometry y="30" width="210" height="90" as="geometry" /></mxCell>
        <mxCell id="conflict" value="冲突建模" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#E9E2F3;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="conflict_text" value="资源区间最大团&lt;br&gt;射击唯一性&lt;br&gt;拍照角差冲突集 𝒜" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="conflict"><mxGeometry y="30" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="stage1" value="第一级：任务数" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#E9E2F3;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="310" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="stage1_text" value="&lt;i&gt;N&lt;/i&gt;* = max Σ&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt; ∈ {0,1}" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="stage1"><mxGeometry y="30" width="210" height="90" as="geometry" /></mxCell>
        <mxCell id="stage2" value="第二级：最差裕度" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#E9E2F3;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="310" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="stage2_text" value="&lt;i&gt;z&lt;/i&gt;* = max min &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;固定 Σ&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt; = &lt;i&gt;N&lt;/i&gt;*" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="stage2"><mxGeometry y="30" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="stage3" value="第三级：总体裕度" style="swimlane;html=1;rounded=0;startSize=30;horizontal=1;fillColor=#E9E2F3;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="745" y="500" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="stage3_text" value="max Σ&lt;i&gt;m&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;固定 &lt;i&gt;N&lt;/i&gt;* 与 &lt;i&gt;z&lt;/i&gt;*" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;" vertex="1" parent="stage3"><mxGeometry y="30" width="220" height="90" as="geometry" /></mxCell>

